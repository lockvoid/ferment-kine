{ "version": 1, "size": { "width": 64, "height": 64 },
  "inputs": [ { "key": "progress", "type": "unit", "default": 0 } ],
  "root": { "kind": "shape", "key": "dot",
    "geometry": { "kind": "ellipse", "cx": 32, "cy": 32, "rx": 20, "ry": 20 },
    "fill": { "kind": "solid", "color": "#FF0000" } },
  "animators": [ { "target": "dot", "property": "opacity", "driver": "progress",
    "keyframes": [ { "at": 0.25, "value": 0 }, { "at": 1, "value": 1 } ] } ] }
